<Page
    x:Class="SandboxProbe.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SandboxProbe"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#101827">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Chronos Runtime" Foreground="White"
                       FontSize="29" FontWeight="SemiBold" />
            <TextBlock Text="打开 .chronos 程序包，安全地按其声明的入口运行。"
                       Foreground="#B8C4D9" TextWrapping="Wrap" Margin="0,8,0,10" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="打开程序包" Click="OnOpenPackage"
                        Style="{StaticResource AccentButtonStyle}" MinWidth="140" Margin="0,0,8,0" />
                <Button Content="运行内置演示" Click="OnRunBundledDemo" MinWidth="140" Margin="0,0,8,0" />
                <Button Content="清除日志" Click="OnClearLog" MinWidth="100" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="等待选择 .chronos 程序包"
                       Foreground="#9FB3C8" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,12">
            <Border Background="#FFFFFF" CornerRadius="6" Padding="8">
                <ContentControl x:Name="DynamicHost">
                    <TextBlock Text="程序包中的 XAML 会在这里显示。" Foreground="#4B5563"
                               TextWrapping="Wrap" Margin="8" />
                </ContentControl>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#0A1120" BorderBrush="#2A3B55"
                BorderThickness="1" CornerRadius="5" Padding="10">
            <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" Text="Chronos Runtime 已启动。"
                           Foreground="#C8D5E8" FontFamily="Consolas" FontSize="12"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
